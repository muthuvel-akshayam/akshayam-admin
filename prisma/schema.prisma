generator client {
  provider = "prisma-client"
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                 String                 @id
  email                              String?                @unique
  mobile_no                          String?                @unique
  password                           String?
  role                               UserRole               @default(USER)
  status                             String                 @default("ACTIVE")
  createdAt                          DateTime               @default(now())
  updatedAt                          DateTime               @updatedAt
  userIndex                          Int?
  isFeatured                         Boolean                @default(false)
  userid                             String?                @unique
  paymentScreenshot                  String?
  receivedRequests                   ContactApproval[]      @relation("ReceivedRequests")
  sentRequests                       ContactApproval[]      @relation("SentRequests")
  expectations                       Expectations?
  family                             Family?
  passwordResetRequests              PasswordResetRequest[]
  profile                            Profile?
  recipientUserSentLogs              ProfileSentLog[]       @relation("RecipientUserSentLogs")
  targetUserSentLogs                 ProfileSentLog[]       @relation("TargetUserSentLogs")
  Shortlist_Shortlist_targetIdToUser Shortlist[]            @relation("Shortlist_targetIdToUser")
  Shortlist_Shortlist_userIdToUser   Shortlist[]            @relation("Shortlist_userIdToUser")

  @@index([role, status])
}

model Profile {
  id                  String            @id
  userId              String            @unique
  name                String
  gender              Gender
  livingCountry       String
  state               String
  city                String
  religion            String
  caste               String
  subCaste            String?
  koottam             String?
  dob                 DateTime
  tob                 String?
  lob                 String?
  height              Float
  weight              Float
  physicalCondition   PhysicalCondition
  skinColour          String
  maritalStatus       MaritalStatus
  familyStatus        FamilyStatus
  foodHabits          Habit
  drinkingHabits      Habit
  smokingHabits       Habit
  rasi                String?
  nakshatra           String?
  poruthaNakshatram   String[]
  dosham              String?
  jathakamUrl         String?
  photoUrl            String?
  casteCertificateUrl String?
  hideMobileNo        Boolean           @default(true)
  hideHouseAddress    Boolean           @default(true)
  hideHouseLocation   Boolean           @default(true)
  status              ProfileStatus     @default(PENDING)
  approvedAt          DateTime?
  approvedBy          String?
  rejectedReason      String?
  isLive              Boolean           @default(false)
  amsamGrid           Json?
  dasaBalance         String?
  hidePhoto           Boolean           @default(false)
  houseAddress        String?
  rasiGrid            Json?
  jathagamData        Json?
  idProofUrl          String?
  displayId           String?           @unique
  houseLocation       String?
  profileCreatedBy    String?
  reviewerId          String?
  educations          Education[]
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, isLive])
}

model Education {
  id          String  @id
  profileId   String
  level       String
  degreeName  String
  institution String
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Family {
  id                 String              @id
  userId             String              @unique
  fatherName         String?
  fatherLivingStatus ParentLivingStatus?
  fatherStatus       String?
  fatherMobile       String?
  motherName         String?
  motherLivingStatus ParentLivingStatus?
  motherStatus       String?
  motherMobile       String?
  workNature         WorkNature?
  salary             String?
  organisation       String?
  designation        String?
  workingAddress     String?
  googleLocation     String?
  rentalIncome       String?
  houseType          String?
  houseSqFt          String?
  siteLand           String?
  thottam            String?
  vacantLand         String?
  totalAssetValue    String?
  assetComments      String?
  dowryDetails       String?
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  siblings           Sibling[]
}

model Sibling {
  id       String @id
  familyId String
  name     String
  relation String
  status   String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

model Expectations {
  id                      String   @id
  userId                  String   @unique
  expectedHeight          Float?
  colourPreference        String?
  maxAgeLimit             Int?
  dowryExpectation        String?
  preferredSectors        String[]
  preferredLocations      String[]
  expectedIncome          String?
  expectsRentalIncome     Boolean?
  expectsThottam          Boolean?
  vacantLand              String?
  preferredDistanceRadius Int?
  city                    String?
  comments                String?
  expectsVacantLand       Boolean?
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContactApproval {
  id          String         @id
  requesterId String
  recipientId String
  status      ApprovalStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  recipient   User           @relation("ReceivedRequests", fields: [recipientId], references: [id], onDelete: Cascade)
  requester   User           @relation("SentRequests", fields: [requesterId], references: [id], onDelete: Cascade)

  @@unique([requesterId, recipientId])
}

model NakshatraCompatibility {
  id                 String   @id
  maleNakshatra      String
  femaleNakshatra    String
  compatibilityScore Int
  compatibilityType  String
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([maleNakshatra, femaleNakshatra])
  @@index([maleNakshatra])
  @@index([femaleNakshatra])
}

model SiteSettings {
  id                    String   @id @default("default_settings")
  minMaleAge            Int      @default(21)
  minFemaleAge          Int      @default(18)
  maxPhotoSizeMb        Int      @default(5)
  maxDocSizeMb          Int      @default(10)
  featuredProfilesLimit Int      @default(12)
  maintenanceMode       Boolean  @default(false)
  updatedAt             DateTime @updatedAt
}

model AdminAuditLog {
  id        String   @id
  adminId   String
  adminName String?
  action    String
  targetId  String?
  details   String?
  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([action])
}

model PasswordResetRequest {
  id        String              @id @default(uuid())
  userId    String
  status    PasswordResetStatus @default(PENDING)
  isRead    Boolean             @default(false)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([isRead])
}

model ProfileSentLog {
  id              Int               @id @default(autoincrement())
  targetUserId    String
  recipientUserId String
  status          ProfileSentStatus @default(SENT)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  recipientUser   User              @relation("RecipientUserSentLogs", fields: [recipientUserId], references: [id], onDelete: Cascade)
  targetUser      User              @relation("TargetUserSentLogs", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([targetUserId, recipientUserId])
}

model CasteLookup {
  id       Int    @id @default(autoincrement())
  religion String
  caste    String
  subcaste String

  @@index([religion, caste])
  @@index([religion])
}

model Shortlist {
  id                            String   @id
  userId                        String
  targetId                      String
  createdAt                     DateTime @default(now())
  User_Shortlist_targetIdToUser User     @relation("Shortlist_targetIdToUser", fields: [targetId], references: [id], onDelete: Cascade)
  User_Shortlist_userIdToUser   User     @relation("Shortlist_userIdToUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetId])
}

enum Gender {
  MALE
  FEMALE
}

enum PhysicalCondition {
  SLIM
  AVERAGE
  FAT
}

enum MaritalStatus {
  NEVER_MARRIED
  DIVORCED
  WIDOWED
  AWAITING_DIVORCE
}

enum FamilyStatus {
  MIDDLE
  UPPER_MIDDLE
  HIGH
  VIP
  LOW
}

enum Habit {
  NONE
  OCCASIONAL
  REGULAR
}

enum ParentLivingStatus {
  ALIVE
  LATE
}

enum WorkNature {
  JOB
  BUSINESS
  NOT_WORKING
}

enum ApprovalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum UserRole {
  USER
  ADMIN
}

enum ProfileStatus {
  PENDING
  APPROVED
  REJECTED
  MATCHED_REMOVED
}

enum ProfileSentStatus {
  SENT
  NOT_MATCHED
}

enum PasswordResetStatus {
  PENDING
  RESOLVED
}
