// ==========================================
// 4. NEW MODELS FOR ADMIN MODULE
// ==========================================

model NakshatraCompatibility {
  id                String   @id @default(uuid())
  maleNakshatra     String
  femaleNakshatra   String
  compatibilityScore Int     // e.g., 1 to 10 or percentage
  compatibilityType String   // e.g., "Uthamam" (Excellent), "Madhyamam" (Average), "Adhamam" (Poor)
  notes             String?  // Additional astrological notes from Excel
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([maleNakshatra, femaleNakshatra])
  @@index([maleNakshatra])
  @@index([femaleNakshatra])
}

model SiteSettings {
  id                    String   @id @default("default_settings")
  minMaleAge            Int      @default(21)
  minFemaleAge          Int      @default(18)
  maxPhotoSizeMb        Int      @default(5)
  maxDocSizeMb          Int      @default(10)
  featuredProfilesLimit Int      @default(12)
  maintenanceMode       Boolean  @default(false)
  updatedAt             DateTime @updatedAt
}

model AdminAuditLog {
  id          String   @id @default(uuid())
  adminId     String
  adminName   String?
  action      String   // e.g., "APPROVE_PROFILE", "REJECT_PROFILE", "MAKE_ADMIN", "UPDATE_SETTINGS"
  targetId    String?  // ID of profile, user, or setting modified
  details     String?  // JSON string or summary of changes
  createdAt   DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([action])
}
